/* AquaAlert v2.1 */
@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap');

*,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  font-size: 15px;
  scroll-behavior: smooth;
}

/* â”€â”€ DARK THEME â”€â”€ */
:root {
  /* Backgrounds */
  --bg: #090a0c;
  --bg2: #0c0d10;
  --surface: #0e1013;
  --surface2: #111418;
  --surface3: #151820;
  --surface4: #1a1d24;
  /* Borders */
  --border: rgba(38, 42, 52, 0.8);
  --border2: rgba(45, 50, 62, 0.6);
  --border3: rgba(55, 60, 74, 0.9);
  /* Text */
  --text: #9aa3b2;
  --text2: #7a8494;
  --text3: #5a6272;
  --muted: #7a8898;
  --muted2: #525d6e;
  /* Muted accents â€” no bright colors */
  --blue: #3a5878;
  --blue2: #2a4060;
  --blue3: #1e3050;
  --green: #2a6a3a;
  --green2: #1e5028;
  --amber: #7a6a14;
  --amber2: #5a4e10;
  --red: #8b2020;
  --red2: #6a1818;
  --purple: #4a3870;
  --purple2: #382860;
  --indigo: #3a4070;
  --cyan: #1a5060;
  /* App chrome */
  --topbar: #07080b;
  --sidebar: #0c0d10;
  /* Shadows */
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.5);
  --shadow: 0 4px 12px rgba(0, 0, 0, 0.55);
  --shadow-lg: 0 8px 30px rgba(0, 0, 0, 0.6);
  --shadow-xl: 0 16px 50px rgba(0, 0, 0, 0.7);
  --glow-blue: none;
  --glow-green: none;
  --glow-red: none;
  /* Radius */
  --radius-sm: 6px;
  --radius: 8px;
  --radius-lg: 10px;
  --radius-xl: 12px;
}

/* â”€â”€ LIGHT THEME â”€â”€ */
[data-theme="light"] {
  --bg: #f8fafc;
  --bg2: #f1f5f9;
  --surface: #ffffff;
  --surface2: #f1f5f9;
  --surface3: #e2e8f0;
  --surface4: #cbd5e1;
  --border: rgba(0, 0, 0, 0.1);
  --border2: rgba(0, 0, 0, 0.14);
  --border3: rgba(0, 0, 0, 0.2);
  --text: #0f172a;
  --text2: #1e293b;
  --text3: #334155;
  --muted: #475569;
  --muted2: #334155;
  --blue: #2563eb;
  --blue2: #1d4ed8;
  --blue3: #1e40af;
  --green: #059669;
  --green2: #047857;
  --amber: #b45309;
  --amber2: #92400e;
  --red: #dc2626;
  --red2: #b91c1c;
  --purple: #7c3aed;
  --purple2: #6d28d9;
  --indigo: #4f46e5;
  --cyan: #0891b2;
  --topbar: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
  --sidebar: #ffffff;
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.12);
  --shadow: 0 2px 6px rgba(0, 0, 0, 0.12), 0 1px 2px rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 6px 20px rgba(0, 0, 0, 0.14), 0 2px 6px rgba(0, 0, 0, 0.08);
  --shadow-xl: 0 14px 36px rgba(0, 0, 0, 0.16);
  --glow-blue: none;
  --glow-green: none;
  --glow-red: none;
}

/* Soft premium light mode tuning */
[data-theme="light"] body {
  font-family: 'Manrope', 'Inter', 'Outfit', sans-serif;
  background-image:
    radial-gradient(1200px 700px at 15% -10%, rgba(59, 130, 246, 0.08), transparent 60%),
    radial-gradient(900px 600px at 85% 0%, rgba(16, 185, 129, 0.06), transparent 55%),
    linear-gradient(180deg, #eef3f9 0%, #f5f7fb 45%, #fafbfe 100%);
  color: #1e293b;
}

[data-theme="light"] body::before {
  content: '';
  position: fixed;
  inset: 0;
  pointer-events: none;
  background-image: radial-gradient(rgba(15, 23, 42, 0.04) 1px, transparent 1px);
  background-size: 22px 22px;
  opacity: 0.35;
  mix-blend-mode: multiply;
}

[data-theme="light"] h1,
[data-theme="light"] h2,
[data-theme="light"] h3,
[data-theme="light"] h4 {
  font-family: 'Outfit', 'Manrope', sans-serif;
  letter-spacing: -0.2px;
  color: #0f172a;
}

[data-theme="light"] p,
[data-theme="light"] small,
[data-theme="light"] .muted,
[data-theme="light"] .subtle {
}

[data-theme="light"] label,
[data-theme="light"] .label,
[data-theme="light"] .section-title,
[data-theme="light"] .section-label {
}

[data-theme="light"] .card,
[data-theme="light"] .chart-card,
[data-theme="light"] .summary-item,
[data-theme="light"] .alert-card-new,
[data-theme="light"] .lf-card,
[data-theme="light"] .sz-zone-card {
}

[data-theme="light"] .card:hover,
[data-theme="light"] .chart-card:hover,
[data-theme="light"] .summary-item:hover,
[data-theme="light"] .alert-card-new:hover,
[data-theme="light"] .lf-card:hover,
[data-theme="light"] .sz-zone-card:hover {
  transform: translateY(-2px);
}

