/* â•â• FIX WHITE BACKGROUNDS â€” Dashboard, Chips, Icons, Ring â•â• */

/* Stat card icon boxes â€” white square â†’ dark */
html[data-theme=dark] .stat-card-icon {
}

/* Chip cards (ELEV, DRAIN, RAIN) â€” white â†’ dark */
html[data-theme=dark] .chip {
}

html[data-theme=dark] .chip-label {
}

html[data-theme=dark] .chip-value {
}

/* Hero risk badge â€” white â†’ dark */
html[data-theme=dark] .hero-risk-badge {
}

html[data-theme=dark] .hero-risk-value {
}

html[data-theme=dark] .hero-risk-label {
}

/* Ring track — white/light → dark surface */
html[data-theme=dark] .ring-track {
}

html[data-theme=dark] .ring-label {
}

/* Flood status badge */
html[data-theme=dark] .flood-status-badge {
}

/* Connection info box (inline style override via class) */
html[data-theme=dark] .card-body>div[style*="background: 'var(--surface2)'"],
html[data-theme=dark] .card-body>div {
}

/* Any inline white background boxes in dashboard card-body */
html[data-theme=dark] .card-body {
}

/* Input date field */
html[data-theme=dark] input[type="date"] {
  color-scheme: dark;
}

/* City select in dashboard */
html[data-theme=dark] .city-select {
}

html[data-theme=dark] .city-select option {
}

/* Toast â€” no bright red/white */
html[data-theme=dark] .toast {
}

html[data-theme=dark] .toast.error {
}

html[data-theme=dark] .toast.success {
}

html[data-theme=dark] .toast.info {
}

/* Chat trigger â€” bright blue circle â†’ muted */
html[data-theme=dark] .chat-trigger {
}

html[data-theme=dark] .chat-trigger:hover {
}

/* Scan bar fill â€” bright blue â†’ muted */
html[data-theme=dark] .scan-fill {
}

/* Pulse dot â€” no bright glow */
html[data-theme=dark] .pulse-dot.green {
}

html[data-theme=dark] .pulse-dot.red {
}

html[data-theme=dark] .pulse-dot.amber {
}

/* SSB dots â€” no glow */
html[data-theme=dark] .ssb-dot.green {
}

html[data-theme=dark] .ssb-dot.red {
}

html[data-theme=dark] .ssb-dot.amber {
}

/* Custom cursor â€” muted blue */
/* Particles â€” invisible */
html[data-theme=dark] .particle {
}

/* Lightbox nav/close â€” no white */
html[data-theme=dark] .lb-close,
html[data-theme=dark] .lb-nav {
}

html[data-theme=dark] .lb-close:hover {
}

html[data-theme=dark] .lb-nav:not(:disabled):hover {
