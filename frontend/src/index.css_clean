/* â•â• CC RIGHT COLUMN â€” equal height panels â•â• */
.cc-right {
  grid-template-rows: 1fr 1fr 1fr;
  gap: 10px;
  align-items: stretch;
  min-height: 0;
}

.cc-right .cc-panel,
.cc-right .cc-right-card {
  min-height: 0;
}

/* â•â• SPACING â€” add breathing room between all boxes â•â• */

