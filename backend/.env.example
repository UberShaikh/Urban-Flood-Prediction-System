# AquaAlert Backend Environment variables
# Copy this file to .env and fill in the values

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# News API Key (get from https://newsapi.org/)
NEWS_API_KEY=your_newsapi_key_here

# Google Earth Engine (GEE)
# GEE_SERVICE_ACCOUNT_FILE=path/to/service_account.json

# ── Email Escalation (Gmail SMTP) ─────────────────────────────────
SMTP_EMAIL=your_gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password
# Comma-separated email recipients
ALERT_RECIPIENTS=recipient1@example.com,recipient2@example.com

# ── Twilio WhatsApp Escalation ───────────────────────────────────────
# Get from https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# Twilio WhatsApp sender number (E.164 format, no whatsapp: prefix needed here)
# Sandbox number: +14155238886 | Or your approved WhatsApp Business number
WHATSAPP_FROM_NUMBER=+14155238886
# Comma-separated recipient WhatsApp numbers (E.164 format, must have joined sandbox)
WHATSAPP_RECIPIENTS=+91XXXXXXXXXX,+91XXXXXXXXXX