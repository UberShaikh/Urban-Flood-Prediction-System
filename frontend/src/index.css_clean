/* General body text â€” never pure white */
html[data-theme=dark] body,
html[data-theme=dark] .app {
}

/* Any element that might render white text */
html[data-theme=dark] .acn-city,
html[data-theme=dark] .alert-city,
html[data-theme=dark] .nb-name,
html[data-theme=dark] .sim-result-city,
html[data-theme=dark] .vr-state,
html[data-theme=dark] .ring-pct,
html[data-theme=dark] .stat-card-value,
html[data-theme=dark] .acn-prob-val,
html[data-theme=dark] .summary-count,
html[data-theme=dark] .wmc-val,
html[data-theme=dark] .hero-city,
html[data-theme=dark] .hero-risk-value,
html[data-theme=dark] .cs-title,
html[data-theme=dark] .dsc-title,
html[data-theme=dark] .mcp-city,
html[data-theme=dark] .sim-comp-val {
}

/* Recharts axis text â€” no white */
html[data-theme=dark] .recharts-text,
html[data-theme=dark] .recharts-cartesian-axis-tick-value {
}

/* Tooltip text */
html[data-theme=dark] .recharts-tooltip-wrapper * {
}

/* Scan bar loading text */
html[data-theme=dark] .vr-loading span,
html[data-theme=dark] .alerts-loading span {
}

/* Flood status badge text */
