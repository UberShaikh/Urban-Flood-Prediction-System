/* ═══ SAFE ZONES — Enhanced Intelligence UI ═══ */

/* Intelligence bar */
.sz-intel-bar {
  display: flex;
  align-items: center;
  gap: 16px;
  background: #0e1013;
  border: 1px solid rgba(38, 42, 52, 0.9);
  border-radius: 10px;
  padding: 12px 20px;
  flex-shrink: 0;
  flex-wrap: wrap;
}

.sz-intel-city {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.sz-intel-flood {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 16px;
  border-left: 1px solid rgba(55, 62, 75, 0.6);
  border-right: 1px solid rgba(55, 62, 75, 0.6);
}

.sz-intel-label {
  font-size: .6rem;
  font-weight: 700;
  color: #5a6272;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.sz-intel-val {
  font-size: .9rem;
  font-weight: 800;
  font-family: 'JetBrains Mono', monospace;
}

.sz-intel-band {
  font-size: .58rem;
  font-weight: 800;
  letter-spacing: 1.5px;
  padding: 3px 8px;
  border-radius: 4px;
  border: 1px solid transparent;
}

.sz-intel-stats {
  display: flex;
  gap: 16px;
  flex: 1;
}

.sz-intel-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}

.sz-is-num {
  font-size: 1.1rem;
  font-weight: 800;
  font-family: 'JetBrains Mono', monospace;
  line-height: 1;
}

.sz-is-lbl {
  font-size: .55rem;
  font-weight: 700;
  color: #5a6272;
  letter-spacing: .8px;
  text-transform: uppercase;
}

.sz-intel-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-left: auto;
  flex-shrink: 0;
}

/* AI Recommendation strip */
.sz-recs-strip {
  background: linear-gradient(135deg, #0e1118 0%, #111825 100%);
  border: 1px solid rgba(129, 140, 248, 0.25);
  border-radius: 10px;
  padding: 14px 16px;
  flex-shrink: 0;
}

.sz-recs-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;
  font-size: .65rem;
  font-weight: 800;
  color: #818cf8;
  letter-spacing: 1.2px;
  text-transform: uppercase;
}

.sz-recs-sub {
  font-size: .6rem;
  color: #5a6272;
  font-weight: 500;
  letter-spacing: 0;
  text-transform: none;
  margin-left: 4px;
}

.sz-recs-close {
  margin-left: auto;
  background: none;
  border: none;
  color: #5a6272;
  cursor: pointer;
  font-size: .8rem;
  line-height: 1;
}

.sz-recs-close:hover {
  color: #9aa3b2;
}

.sz-recs-cards {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  padding-bottom: 2px;
}

.sz-rec-card {
  background: #111418;
  border: 1px solid rgba(55, 62, 75, 0.8);
  border-radius: 10px;
  padding: 12px 14px;
  display: flex;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  min-width: 240px;
  flex-shrink: 0;
  transition: all .2s;
  border-left: 3px solid var(--rc, #818cf8);
  position: relative;
}

.sz-rec-card:hover {
  background: #151820;
  border-color: rgba(129, 140, 248, 0.3);
}

.sz-rec-rank {
  font-size: 1.3rem;
  font-weight: 900;
  color: #818cf8;
  font-family: 'JetBrains Mono', monospace;
  opacity: 0.7;
  flex-shrink: 0;
}

.sz-rec-body {
  flex: 1;
  min-width: 0;
}

.sz-rec-name {
  font-size: .78rem;
  font-weight: 700;
  color: #c8d8f0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 4px;
}

.sz-rec-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: .62rem;
  color: #5a6272;
}

.sz-rec-elev {
  font-family: 'JetBrains Mono', monospace;
  color: #60a5fa;
}

.sz-rec-dist {
  font-family: 'JetBrains Mono', monospace;
  color: #7a8898;
}

.sz-rec-score {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  flex-shrink: 0;
}

.sz-score-ring {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: conic-gradient(var(--sc, #16a34a) calc(var(--sp, 0) * 3.6deg), rgba(255, 255, 255, 0.05) 0deg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: .7rem;
  font-weight: 800;
  font-family: 'JetBrains Mono', monospace;
}

.sz-rec-conf {
  font-size: .58rem;
  color: #5a6272;
  font-weight: 700;
}

/* Zone card enhancements */
.sz-zone-badges {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}

.sz-risk-badge {
  font-size: .55rem;
  font-weight: 800;
  letter-spacing: .8px;
  padding: 2px 7px;
  border-radius: 3px;
  border: 1px solid transparent;
}

.sz-zone-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
  flex-shrink: 0;
}

.sz-elev-badge {
  display: flex;
  align-items: center;
  gap: 3px;
  font-size: .58rem;
  color: #60a5fa;
  font-family: 'JetBrains Mono', monospace;
  font-weight: 700;
}

/* AI Score bar */
.sz-score-bar-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 7px;
}

.sz-score-bar-track {
  flex: 1;
  height: 3px;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 999px;
  overflow: hidden;
}

.sz-score-bar-fill {
  height: 100%;
  border-radius: 999px;
  transition: width .6s ease;
}

.sz-score-label {
  font-size: .58rem;
  font-weight: 800;
  font-family: 'JetBrains Mono', monospace;
  flex-shrink: 0;
}

/* Occupancy bar */
.sz-occupancy-wrap {
  margin-top: 7px;
}

.sz-occ-label {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: .6rem;
  color: #5a6272;
  margin-bottom: 4px;
}

.sz-occ-track {
  height: 4px;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 999px;
  overflow: hidden;
}

.sz-occ-fill {
  height: 100%;
  border-radius: 999px;
  transition: width .6s ease;
}

/* Risk detail */
.sz-detail-risk {
  font-size: .68rem;
  font-weight: 600;
  padding: 6px 10px;
  border-radius: 6px;
  border: 1px solid transparent;
  margin-top: 4px;
}

/* Evacuate glow */
.sz-zone-card.selected .sz-evacuate-glow,
.sz-evacuate-glow {
  position: absolute;
  inset: 0;
  border-radius: 8px;
  box-shadow: inset 0 0 0 2px rgba(204, 34, 34, 0.4), 0 0 16px rgba(204, 34, 34, 0.15);
  pointer-events: none;
  animation: evacPulse 1.8s ease-in-out infinite;
}

@keyframes evacPulse {

  0%,
  100% {
    opacity: 0.6;
  }

  50% {
    opacity: 1;
  }
}

/* Top recommendation crown */
.sz-zone-card {
  position: relative;
}

.sz-rec-crown {
  font-size: .55rem;
  font-weight: 800;
  color: #818cf8;
  letter-spacing: 1px;
  background: rgba(129, 140, 248, 0.1);
  border: 1px solid rgba(129, 140, 248, 0.2);
  padding: 2px 8px;
  border-radius: 3px;
  margin-bottom: 6px;
  display: inline-block;
}

.sz-zone-card.top-rec {
  border-top: 2px solid rgba(129, 140, 248, 0.4);
}

/* Map overlays */
.sz-map-flood-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 1000;
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: .65rem;
  font-weight: 800;
  padding: 5px 10px;
  border-radius: 6px;
  border: 1px solid;
  background: rgba(9, 10, 12, 0.85);
  backdrop-filter: blur(4px);
  letter-spacing: 1px;
  font-family: 'JetBrains Mono', monospace;
}

/* Legend enhancements */
.sz-legend-title {
  font-size: .55rem;
  font-weight: 800;
  color: #506a88;
  letter-spacing: 1px;
  text-transform: uppercase;
  margin-bottom: 2px;
}

.sz-legend-sep {
  height: 1px;
  background: rgba(55, 62, 75, 0.5);
  margin: 4px 0;
}

/* Risk filter pills row */
.sz-risk-pills {
  align-items: center;
  flex-wrap: wrap;
}

.sz-filter-label {
  font-size: .58rem;
  font-weight: 800;
  color: #506a88;
  letter-spacing: 1px;
  text-transform: uppercase;
  flex-shrink: 0;
}

.sz-rpill {
  font-size: .6rem;
}

/* List footer */
.sz-list-footer {
  font-size: .6rem;
  color: #5a6272;
  padding: 8px 14px;
  border-top: 1px solid rgba(38, 42, 52, 0.8);
  display: flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}


.alerts-page {
  border-radius: var(--radius-lg);
  padding: 20px;
}

.alerts-summary {
  display: flex;
  gap: 14px;
  margin-bottom: 20px;
}

.summary-item {
  flex: 1;
  padding: 16px 20px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  gap: 16px;
}

.summary-item.summary-critical {
}

.summary-item.summary-warning {
}

.summary-item.summary-safe {
}

.summary-count {
  font-weight: 800;
  font-family: 'JetBrains Mono', monospace;
}

.summary-label {
  font-size: .68rem;
  font-weight: 700;
  text-transform: uppercase;
}

.alerts-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.alert-card-new {
  border-radius: 8px;
  display: flex;
  overflow: hidden;
}

.alert-card-new:hover {
}

.acn-body {
  padding: 16px 20px;
  flex: 1;
}

.acn-city {
  font-weight: 800;
  letter-spacing: .5px;
}

.acn-level {
  padding: 3px 10px;
  border-radius: 4px;
  font-size: .65rem;
  font-weight: 700;
}

.acn-meta {
  font-size: .72rem;
  margin-top: 10px;
  display: flex;
  gap: 14px;
}

.acn-action {
  margin-top: 12px;
  font-size: .75rem;
  font-weight: 500;
}

.acn-right {
  padding: 16px 20px;
  border-left: 1px solid rgba(38, 42, 52, 0.6);
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  min-width: 140px;
}

.acn-prob-val {
  font-weight: 800;
  font-family: 'JetBrains Mono', monospace;
}

.acn-prob-label {
  font-size: .6rem;
  text-transform: uppercase;
}

/* Offline/Empty States */
.offline-banner {
}

.offline-title {
}

.offline-sub {
}

.vr-empty {
  font-weight: 600;
}

/* touch */


/* ══════════════════════════════════════════
   KNOWLEDGE BASE STYLES
══════════════════════════════════════════ */

.kb-page {
  display: flex;
  flex-direction: column;
  gap: 24px;
  width: 100%;
}

.kb-tabs {
  display: flex;
  gap: 8px;
  padding: 0;
  border-bottom: 1px solid var(--border);
  margin-bottom: 16px;
}

.kb-tab {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 16px;
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  color: var(--text3);
  font-size: .75rem;
  font-weight: 600;
  cursor: pointer;
  transition: all .2s;
  letter-spacing: .5px;
  text-transform: uppercase;
}

.kb-tab:hover {
  color: var(--text2);
  background: rgba(255, 255, 255, 0.02);
}

.kb-tab.active {
  color: var(--blue);
  border-bottom-color: var(--blue);
}

.kb-content {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.kb-section-header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 0;
  margin-bottom: 12px;
}

.kb-section-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--text);
}

.kb-section-sub {
  font-size: .72rem;
  color: var(--text3);
  margin-top: 4px;
}

/* --- SIMULATION PICKER (NAVBAR) --- */
.topbar-center {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
}

.sim-picker {
  display: flex;
  align-items: center;
  gap: 14px;
  border: 1px solid var(--border2);
  padding: 4px 20px;
  border-radius: 999px;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  height: 44px;
  box-shadow: var(--shadow-sm);
}

.sim-picker:hover {
  border-color: var(--blue);
}

.sim-picker.is-simulating {
  border-color: var(--amber);
  box-shadow: 0 0 20px rgba(122, 106, 20, 0.1);
}

.sim-icon {
  display: flex;
  align-items: center;
  color: var(--muted2);
  transition: color 0.3s;
}

.sim-picker.is-simulating .sim-icon {
  color: var(--amber);
}

.sim-info {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
}

.sim-label {
  font-size: 0.58rem;
  font-weight: 900;
  color: #64748b;
  /* Brighter grey-blue for live mode */
  letter-spacing: 1.2px;
  text-transform: uppercase;
  margin-bottom: 3px;
}

.sim-picker.is-simulating .sim-label {
  color: #fbbf24;
  /* Brighter Amber for simulation */
}

.sim-picker input[type="date"] {
  /* Pure White for maximum visibility */
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.85rem;
  font-weight: 700;
  outline: none;
  cursor: pointer;
  padding: 0;
  margin: 0;
  width: 120px;
  transition: color 0.3s;
}

/* Customizing the date picker appearance */
.sim-picker input[type="date"]::-webkit-calendar-picker-indicator {
  filter: invert(0.8);
  cursor: pointer;
  margin-left: 6px;
  transition: all 0.3s;
}

.sim-picker.is-simulating input[type="date"]::-webkit-calendar-picker-indicator {
  filter: invert(0.6) sepia(1) saturate(5) hue-rotate(5deg);
}

.sim-reset-btn {
  color: #fff;
  transform: rotate(-45deg);
  filter: invert(0);
}

/* Pipeline Track */
.docs-track {
  position: relative;
  height: 60px;
  margin: 20px 0;
  display: flex;
  align-items: center;
}

.track-dots {
  display: flex;
  justify-content: space-between;
  width: 100%;
  position: relative;
  z-index: 2;
}

.track-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  border: 2px solid var(--surface);
  box-shadow: 0 0 0 3px var(--surface);
  flex-shrink: 0;
}

.track-line {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, #60a5fa, #38bdf8, #818cf8, #c084fc, #fb7185, #fbbf24, #34d399);
  transform: translateY(-50%);
  z-index: 1;
}

/* Stage Cards */
.docs-stages {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 16px;
  margin-top: 24px;
}

.docs-stage-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  border-left: 4px solid;
  overflow: hidden;
  transition: all .2s;
}

.docs-stage-card:hover {
  border-color: var(--border3);
  box-shadow: var(--shadow-lg);
  transform: translateY(-2px);
}

.dsc-header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px;
  border-bottom: 1px solid var(--border);
  background: var(--surface2);
}

.dsc-step {
  width: 32px;
  height: 32px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: .75rem;
  flex-shrink: 0;
}

.dsc-title-wrap {
  flex: 1;
  min-width: 0;
}

.dsc-title {
  font-size: .85rem;
  font-weight: 700;
  color: var(--text);
  line-height: 1.3;
}

.dsc-file {
  font-size: .62rem;
  color: var(--muted2);
  font-family: 'JetBrains Mono', monospace;
  margin-top: 2px;
}

.dsc-badge {
  font-size: .6rem;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 999px;
  border: 1px solid;
  white-space: nowrap;
  flex-shrink: 0;
  letter-spacing: .3px;
}

.dsc-body {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.dsc-section {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.dsc-label {
  font-size: .65rem;
  font-weight: 700;
  color: var(--text2);
  text-transform: uppercase;
  letter-spacing: .5px;
}

.dsc-text {
  font-size: .73rem;
  color: var(--text3);
  line-height: 1.6;
}

.dsc-list {
  margin: 0;
  padding-left: 18px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.dsc-list li {
  font-size: .73rem;
  color: var(--text3);
  line-height: 1.5;
}

/* Notebook Grid */
.nb-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 16px;
}

.nb-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  transition: all .2s;
  cursor: pointer;
}

.nb-card:hover {
  border-color: var(--border3);
  box-shadow: var(--shadow-lg);
  transform: translateY(-3px);
}

.nb-accent {
  height: 3px;
  width: 100%;
}

.nb-info {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.nb-name {
  font-size: .82rem;
  font-weight: 700;
  line-height: 1.3;
}

.nb-desc {
  font-size: .72rem;
  color: var(--text3);
  line-height: 1.5;
}

.nb-file {
  font-size: .62rem;
  color: var(--muted2);
  font-family: 'JetBrains Mono', monospace;
  margin-top: 4px;
}

/* Technology Stack */
.tech-stack-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 16px;
}

.tech-category {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 16px;
  transition: all .2s;
}

.tech-category:hover {
  border-color: var(--border3);
  box-shadow: var(--shadow);
}

.tech-category-title {
  font-size: .85rem;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--border);
}

.tech-items {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.tech-item {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.tech-item-name {
  font-size: .75rem;
  font-weight: 600;
  color: var(--text2);
}

.tech-item-desc {
  font-size: .68rem;
  color: var(--text3);
  line-height: 1.4;
}

/* ═══ ESCALATION & SAFE ZONES (Alerts Tab) ═══ */

.acn-escalation {
  margin-top: 14px;
  padding: 10px 14px;
  background: rgba(56, 189, 248, 0.05);
  border: 1px solid rgba(56, 189, 248, 0.15);
  border-radius: 6px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.escalation-header {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: .68rem;
  font-weight: 700;
  color: #38bdf8;
  text-transform: uppercase;
  letter-spacing: .5px;
}

.escalation-authorities {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: .62rem;
  color: #7a8898;
}

.acn-safe-zones {
  margin-top: 16px;
  border-top: 1px solid rgba(38, 42, 52, 0.6);
  padding-top: 14px;
}

.sz-header {
  font-size: .62rem;
  font-weight: 800;
  color: #506a88;
  letter-spacing: 1.2px;
  margin-bottom: 10px;
}

.sz-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 10px;
}

.sz-mini-card {
  background: #0f1115;
  border: 1px solid rgba(55, 62, 75, 0.5);
  padding: 10px;
  border-radius: 6px;
  transition: all .2s;
}

.sz-mini-card:hover {
  border-color: rgba(56, 189, 248, 0.3);
  background: #12151a;
}

.sz-mini-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
}

.sz-name {
  font-size: .7rem;
  font-weight: 700;
  color: #e2e8f0;
  display: flex;
  align-items: center;
  gap: 5px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sz-score {
  font-size: .58rem;
  font-weight: 800;
  color: #10b981;
  background: rgba(16, 185, 129, 0.1);
  padding: 2px 5px;
  border-radius: 4px;
}

.sz-mini-meta {
  display: flex;
  gap: 8px;
  font-size: .6rem;
  color: #5a6272;
  font-weight: 600;
}
/* --- SIMULATION PICKER (NAVBAR) --- */
.topbar-center {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
}

.sim-picker {
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px solid var(--border2);
  padding: 4px 18px;
  border-radius: 999px;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  height: 44px;
}

.sim-picker:hover {
  border-color: var(--blue);
}

.sim-picker.is-simulating {
  border-color: var(--amber);
  box-shadow: 0 0 20px rgba(122, 106, 20, 0.1);
}

.sim-info {
  display: flex;
  flex-direction: column;
  line-height: 1;
}

.sim-picker input[type="date"] {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.85rem;
  font-weight: 700;
  outline: none;
  cursor: pointer;
  padding: 0;
  margin: 0;
  width: 120px;
  transition: color 0.3s;
}

[data-theme="light"] .sim-picker input[type="date"] {
}

.sim-picker input[type="date"]::-webkit-calendar-picker-indicator {
  filter: invert(0.6);
  cursor: pointer;
  margin-left: 6px;
  transition: all 0.3s;
}

[data-theme="light"] .sim-picker input[type="date"]::-webkit-calendar-picker-indicator {
  filter: invert(0);
}

.sim-picker.is-simulating input[type="date"]::-webkit-calendar-picker-indicator {
  filter: invert(0.6) sepia(1) saturate(5) hue-rotate(5deg);
}

.sim-reset-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface4);
  border: 1px solid var(--border);
  color: var(--muted);
  width: 28px;
  height: 28px;
  border-radius: 50%;
  cursor: pointer;
  transition: all 0.2s;
  margin-left: 4px;
}

.sim-reset-btn:hover {
  background: var(--amber);
  border-color: var(--amber);
  color: #fff;
  transform: rotate(-30deg);
}
