/* ════ LIVE FEED ════ */
.lf-page {
  display: flex;
  flex-direction: column;
  gap: 16px;
  flex: 1;
}

/* EWS Banner */
.lf-ews-banner {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 20px 24px;
  display: flex;
  gap: 28px;
  align-items: stretch;
  flex-shrink: 0;
}

.lf-ews-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.lf-ews-header {
  display: flex;
  align-items: center;
  gap: 10px;
}

.lf-ews-status {
  font-size: .78rem;
  font-weight: 900;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.lf-ews-score {
  font-size: .65rem;
  font-weight: 800;
  padding: 3px 9px;
  border-radius: 999px;
  letter-spacing: .5px;
}

.lf-ews-action {
  font-size: .9rem;
  font-weight: 600;
  color: var(--text);
  line-height: 1.4;
  margin: 0;
}

.lf-ews-factors {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.lf-factor-tag {
  font-size: .68rem;
  color: var(--text3);
  background: var(--surface2);
  border: 1px solid var(--border2);
  padding: 3px 10px;
  border-radius: 4px;
}

/* Timeline */
.lf-ews-right {
  width: 220px;
  border-left: 1px solid var(--border2);
  padding-left: 24px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  justify-content: center;
  flex-shrink: 0;
}

.lf-tl-title {
  font-size: .6rem;
  font-weight: 800;
  color: var(--muted2);
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.lf-tl-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.lf-tl-hour {
  font-size: .7rem;
  font-weight: 700;
  color: var(--muted);
  width: 26px;
  flex-shrink: 0;
  font-family: 'JetBrains Mono', monospace;
}

.lf-tl-track {
  flex: 1;
  height: 5px;
  background: var(--surface2);
  border-radius: 3px;
  overflow: hidden;
}

.lf-tl-fill {
  height: 100%;
  border-radius: 3px;
  transition: width .5s ease;
}

.lf-tl-val {
  font-size: .72rem;
  font-weight: 800;
  font-family: 'JetBrains Mono', monospace;
  width: 36px;
  text-align: right;
  flex-shrink: 0;
}

/* Feed header */
.lf-feed-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-shrink: 0;
}

[data-theme="light"] .lf-news-link {
}

[data-theme="light"] .lf-news-link:hover {
}

[data-theme="light"] .lf-pill-count {
}

.lf-tab-row {
  display: flex;
  gap: 6px;
}

.lf-tab-pill {
  display: flex;
  align-items: center;
  gap: 7px;
  background: var(--surface);
  border: 1px solid var(--border);
  color: var(--muted);
  padding: 7px 14px;
  border-radius: 7px;
  font-size: .68rem;
  font-weight: 700;
  letter-spacing: .4px;
  transition: .2s;
  cursor: pointer;
}

.lf-tab-pill:hover {
  background: var(--surface2);
  color: var(--text2);
  cursor: pointer;
}

.lf-tab-pill.active {
  background: var(--surface2);
  border-color: var(--border3);
  color: var(--text);
  cursor: pointer;
}

.lf-pill-count {
  background: var(--surface3);
  border: 1px solid var(--border);
  padding: 1px 7px;
  border-radius: 999px;
  font-size: .6rem;
}

.lf-feed-meta {
  display: flex;
  align-items: center;
  gap: 12px;
}

.lf-update-time {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: .68rem;
  color: var(--muted);
}

.lf-refresh-btn {
  display: flex;
  align-items: center;
  gap: 7px;
  background: var(--surface2);
  border: 1px solid var(--border);
  color: var(--text2);
  padding: 7px 14px;
  border-radius: 7px;
  font-size: .68rem;
  font-weight: 700;
  transition: .2s;
  letter-spacing: .5px;
  cursor: pointer;
}

.lf-refresh-btn:hover:not(:disabled) {
  background: var(--surface3);
  border-color: var(--border3);
  cursor: pointer;
}

.lf-refresh-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* Feed grid */
.lf-feed-grid {
  flex: 1;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 14px;
  align-content: flex-start;
  overflow-y: auto;
  padding-bottom: 16px;
}

.lf-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-left: 3px solid var(--accent);
  border-radius: var(--radius);
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 11px;
  transition: background .2s, border-color .2s, box-shadow .2s;
}

.lf-card:hover {
  background: var(--surface2);
  border-color: var(--border3);
}

.lf-card-top {
  display: flex;
  align-items: center;
  gap: 8px;
}

.lf-card-type {
  font-size: .65rem;
  font-weight: 800;
  letter-spacing: .5px;
  display: flex;
  align-items: center;
  gap: 4px;
}

.lf-sev-badge {
  font-size: .6rem;
  font-weight: 800;
  padding: 2px 8px;
  border-radius: 4px;
  letter-spacing: .5px;
  border: 1px solid currentColor;
  opacity: 0.9;
}

.lf-card-time {
  margin-left: auto;
  font-size: .65rem;
  color: var(--text3);
  display: flex;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
}

.lf-card-title {
  font-size: .88rem;
  font-weight: 600;
  color: var(--text);
  line-height: 1.45;
}

.lf-news-link {
  color: var(--text);
  text-decoration: none;
  display: flex;
  align-items: flex-start;
  gap: 5px;
  cursor: pointer;
}

.lf-news-link:hover {
  color: var(--blue);
}

.lf-card-desc {
  font-size: .75rem;
  color: var(--text3);
  line-height: 1.5;
  margin-top: 8px;
  margin-bottom: 8px;
}

.lf-card-footer {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: .68rem;
  color: var(--text3);
}

.lf-card-footer span {
  display: flex;
  align-items: center;
  gap: 5px;
}

.lf-source {
  font-weight: 600;
  color: var(--text2);
}

/* State box */
.lf-state-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 40px;
  color: var(--text3);
  font-size: .75rem;
  font-weight: 600;
}

.lf-state-box small {
  font-size: .65rem;
  color: var(--text3);
  opacity: .7;
}

/* ════ SAFE ZONES ════ */
.sz-page {
  display: flex;
  flex-direction: column;
  gap: 14px;
  flex: 1;
}

/* Stats row */
.sz-stats-row {
  display: flex;
  gap: 12px;
  align-items: stretch;
  flex-shrink: 0;
}

.sz-stat-btn {
  flex: 1;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 14px 18px;
  display: flex;
  align-items: center;
  gap: 14px;
  cursor: pointer;
  transition: .2s;
  text-align: left;
  border-left: 3px solid var(--sz-accent, var(--border));
}

.sz-stat-btn.active {
  background: var(--surface2);
  border-color: var(--sz-accent, var(--border3));
}

.sz-stat-btn:hover {
  background: var(--surface2);
}

.sz-stat-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.sz-stat-num {
  font-size: 1.5rem;
  font-weight: 800;
  font-family: 'JetBrains Mono', monospace;
  line-height: 1;
}

.sz-stat-label {
  font-size: .65rem;
  font-weight: 700;
  color: var(--muted);
  letter-spacing: .5px;
  text-transform: uppercase;
}

.sz-stat-action {
  font-size: .6rem;
  color: var(--muted);
  border: 1px solid var(--border);
  padding: 3px 8px;
  border-radius: 4px;
  flex-shrink: 0;
}

.sz-toolbar {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8px;
  justify-content: center;
}

.sz-error-badge {
  font-size: .65rem;
  color: var(--amber);
  background: rgba(245, 158, 11, 0.1);
  border: 1px solid rgba(245, 158, 11, 0.2);
  padding: 4px 10px;
  border-radius: 4px;
}

.sz-total-badge {
  font-size: .68rem;
  color: var(--muted);
  display: flex;
  align-items: center;
  gap: 6px;
}

.sz-refresh-btn {
  display: flex;
  align-items: center;
  gap: 7px;
  background: var(--surface2);
  border: 1px solid var(--border);
  color: var(--text2);
  padding: 8px 16px;
  border-radius: 7px;
  font-size: .68rem;
  font-weight: 700;
  letter-spacing: .5px;
  transition: .2s;
  cursor: pointer;
}

.sz-refresh-btn:hover:not(:disabled) {
  background: var(--surface3);
  border-color: var(--border3);
}

/* Main layout */
.sz-main {
  flex: 1;
  display: flex;
  gap: 14px;
  min-height: 0;
}

/* Map panel */
.sz-map-panel {
  flex: 1.6;
  display: flex;
  flex-direction: column;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  min-height: 450px;
}

.sz-map-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 16px;
  border-bottom: 1px solid var(--border2);
  background: var(--surface2);
  flex-shrink: 0;
}

.sz-panel-title {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: .68rem;
  font-weight: 800;
  color: var(--text2);
  letter-spacing: .8px;
  text-transform: uppercase;
}

.sz-panel-sub {
  font-size: .65rem;
  color: var(--muted);
}

.sz-map-body {
  flex: 1;
  position: relative;
}

/* Map Legend */
.sz-map-legend {
  position: absolute;
  bottom: 14px;
  right: 14px;
  z-index: 1000;
  background: var(--surface);
  border: 1px solid var(--border3);
  border-radius: 8px;
  padding: 10px 14px;
  display: flex;
  flex-direction: column;
  gap: 7px;
  backdrop-filter: blur(6px);
  box-shadow: var(--shadow-lg);
}

[data-theme="light"] .sz-mini-card {
  background: #ffffff;
  border-color: #e2e8f0;
}

[data-theme="light"] .sz-mini-card:hover {
  background: #f8fafc;
  border-color: #cbd5e1;
}

[data-theme="light"] .sz-name {
  color: #1e293b;
}

[data-theme="light"] .sz-mini-meta {
  color: #64748b;
}

.sz-legend-row {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: .7rem;
  font-weight: 600;
  color: var(--text2);
}

.sz-legend-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
}

/* List panel */
.sz-list-panel {
  width: 340px;
  height: 520px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
}

.sz-list-header {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 12px 14px;
  border-bottom: 1px solid var(--border2);
  background: var(--surface2);
  flex-shrink: 0;
}

.sz-search-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 6px 10px;
  color: var(--muted);
}

.sz-search {
  flex: 1;
  background: none;
  border: none;
  outline: none;
  color: var(--text);
  font-size: .72rem;
  font-family: inherit;
}

.sz-search::placeholder {
  color: var(--muted);
}

.sz-filter-row {
  display: flex;
  gap: 6px;
  padding: 10px 14px;
  border-bottom: 1px solid var(--border2);
  flex-wrap: wrap;
  flex-shrink: 0;
}

.sz-pill {
  display: flex;
  align-items: center;
  gap: 6px;
  background: var(--surface2);
  border: 1px solid var(--border);
  color: var(--muted);
  padding: 5px 11px;
  border-radius: 999px;
  font-size: .65rem;
  font-weight: 700;
  transition: .2s;
  cursor: pointer;
}

.sz-pill:hover {
  background: var(--surface3);
  color: var(--text2);
}

.sz-pill.active {
  background: var(--surface2);
  color: var(--text);
}

.sz-pill-n {
  background: rgba(255, 255, 255, 0.06);
  padding: 1px 6px;
  border-radius: 999px;
  font-size: .6rem;
}

.sz-zone-list {
  flex: 1;
  overflow-y: auto;
  padding: 10px 10px;
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.sz-zone-card {
  background: var(--surface2);
  border: 1px solid var(--border);
  border-left: 3px solid var(--card-accent, var(--border));
  border-radius: 8px;
  padding: 11px 13px;
  cursor: pointer;
  transition: background .15s, border-color .15s;
}

.sz-zone-card:hover {
  background: var(--surface3);
  border-color: var(--border3);
}

.sz-zone-card.selected {
  background: var(--surface3);
  border-color: var(--card-accent, var(--border3));
}

.sz-zone-top {
  display: flex;
  align-items: center;
  gap: 10px;
}

.sz-zone-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.sz-zone-name {
  font-size: .82rem;
  font-weight: 700;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sz-zone-type {
  font-size: .6rem;
  font-weight: 800;
  letter-spacing: .5px;
}

.sz-zone-dist {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0;
  flex-shrink: 0;
}

.sz-zone-dist span {
  font-size: .9rem;
  font-weight: 800;
  font-family: 'JetBrains Mono', monospace;
  line-height: 1;
}

.sz-zone-dist small {
  font-size: .6rem;
  color: var(--muted);
}

.sz-zone-detail {
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid var(--border2);
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.sz-detail-item {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: .72rem;
  color: var(--muted);
  font-weight: 500;
}

.sz-loading-state,
.sz-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 32px 16px;
  color: var(--muted);
  font-size: .72rem;
  font-weight: 600;
  text-align: center;
}

.sz-empty-state small {
  font-size: .65rem;
  opacity: .7;
}

/* Forces the Safe Zones section to maintain a dark, premium aesthetic regardless of the global theme. */

.sz-page {
  border-radius: var(--radius-lg);
  padding: 20px;
}

.sz-stats-row {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}

.sz-city-box {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 18px;
  border-radius: 8px;
  flex-shrink: 0;
}

.sz-city-select {
  cursor: pointer;
  padding: 0;
}

.sz-city-select option {
  background: #0b1628;
  color: #9aa3b2;
}

.sz-stat-filters {
  display: flex;
  gap: 12px;
  flex: 1;
}

.sz-stat-btn {
}

.sz-stat-btn.active {
}

.sz-stat-btn:hover {
}

.sz-stat-num {
}

.sz-stat-label {
}

/* Refresh Button */
.sz-refresh {
  padding: 10px 18px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: .75rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  cursor: pointer;
  transition: all 0.2s;
}

.sz-refresh:hover:not(:disabled) {
}

/* Map & List Panels */
.sz-map-panel,
.sz-list-panel {
}

.sz-map-header,
.sz-list-header {
}

.sz-panel-title {
}

.sz-panel-sub {
}

/* Search Wrap */
.sz-search-wrap {
}

.sz-search {
}

.sz-search::placeholder {
}

/* Filter Pills */
.sz-pill {
}

.sz-pill:hover {
}

.sz-pill.active {
}

.sz-pill-n {
}

/* Zone Cards */
.sz-zone-card {
}

.sz-zone-card:hover {
}

.sz-zone-card.selected {
}

.sz-zone-name {
}

.sz-zone-dist span {
}

.sz-zone-dist small {
}

.sz-zone-detail {
}

.sz-detail-item {
}

/* States */
.sz-loading-state,
.sz-empty-state {
