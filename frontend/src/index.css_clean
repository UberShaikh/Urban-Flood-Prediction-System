/* â•â• COMMAND CENTER â€” NEW CLASS FIXES â•â• */

/* Topbar right blocks */
html[data-theme=dark] .cc-alerts-block {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

html[data-theme=dark] .cc-alerts-label {
  font-size: .58rem;
  color: #7a8898;
  letter-spacing: 2px;
  font-weight: 700;
  text-transform: uppercase;
}

html[data-theme=dark] .cc-alerts-num {
  font-size: .85rem;
  font-weight: 800;
  letter-spacing: 1px;
  font-family: 'JetBrains Mono', monospace;
}

html[data-theme=dark] .cc-time-block {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

html[data-theme=dark] .cc-utc-label {
  font-size: .58rem;
  color: #7a8898;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

html[data-theme=dark] .cc-clock {
  font-size: .85rem;
  color: #5ab4e8;
  font-weight: 700;
  font-family: 'JetBrains Mono', monospace;
}

html[data-theme=dark] .cc-refresh-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(38, 42, 52, 0.9);
  color: #8ea4c0;
  padding: 5px 14px;
  border-radius: 5px;
  font-size: .65rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  cursor: pointer;
  font-family: inherit;
  text-transform: uppercase;
}

html[data-theme=dark] .cc-refresh-btn:hover {
  background: rgba(255, 255, 255, 0.09);
  color: #cdd6e0;
}

/* SDG pill */
html[data-theme=dark] .cc-sdg-pill {
  font-size: .65rem;
  color: #22a060;
  background: rgba(34, 160, 96, 0.1);
  border: 1px solid rgba(34, 160, 96, 0.25);
  border-radius: 5px;
  padding: 3px 10px;
  letter-spacing: .5px;
  font-weight: 600;
}

/* Map layer panel */
html[data-theme=dark] .cc-layers-plus {
  font-size: .9rem;
  font-weight: 700;
  color: #5ab4e8;
  line-height: 1;
}

html[data-theme=dark] .cc-layer-sq {
  width: 9px;
  height: 9px;
  border-radius: 2px;
  flex-shrink: 0;
  display: inline-block;
}

html[data-theme=dark] .cc-legend-sq {
  width: 9px;
  height: 9px;
  border-radius: 2px;
  flex-shrink: 0;
  display: inline-block;
}

/* LIVE badge + zones label */
html[data-theme=dark] .cc-live-badge {
  font-size: .6rem;
  font-weight: 700;
  letter-spacing: 2px;
  color: #2a8a50;
  background: rgba(30, 100, 60, 0.15);
  border: 1px solid rgba(30, 100, 60, 0.3);
  padding: 2px 8px;
  border-radius: 3px;
  animation: pulse-live 2.5s ease-in-out infinite;
}

html[data-theme=dark] .cc-zones-label {
  font-size: .55rem;
  color: #7a8898;
  margin-left: 8px;
  letter-spacing: .5px;
}

/* Right column cards */
html[data-theme=dark] .cc-right-card {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

html[data-theme=dark] .cc-loading-text {
  padding: 16px;
  font-size: .7rem;
  color: #7a8898;
  letter-spacing: 1px;
}

/* Risk level badge */
html[data-theme=dark] .cc-risk-level-badge {
  font-size: .6rem;
  font-weight: 700;
  padding: 2px 9px;
  border-radius: 4px;
  border: 1px solid;
  letter-spacing: 1px;
}

/* SDG badge (urban insights) */
html[data-theme=dark] .cc-sdg-badge {
  font-size: .6rem;
  font-weight: 700;
  color: #6a8858;
  background: rgba(50, 80, 40, 0.2);
  border: 1px solid rgba(50, 80, 40, 0.35);
  padding: 2px 9px;
  border-radius: 4px;
  letter-spacing: .5px;
}

/* SAR stats row */
html[data-theme=dark] .cc-sar-stat-row {
  display: flex;
  gap: 16px;
  padding: 4px 0;
  border-bottom: 1px solid rgba(38, 42, 52, 0.5);
  margin-bottom: 4px;
}

html[data-theme=dark] .cc-sar-stat-col {
  display: flex;
  flex-direction: column;
  gap: 2px;
  flex: 1;
}

html[data-theme=dark] .cc-sar-stat-label {
  font-size: .58rem;
  color: #7a8898;
  letter-spacing: 1.5px;
  font-weight: 600;
  text-transform: uppercase;
}

html[data-theme=dark] .cc-sar-stat-val {
  font-size: .82rem;
  font-weight: 700;
  font-family: 'JetBrains Mono', monospace;
}

/* Historical trends meta */
html[data-theme=dark] .cc-trends-meta {
  font-size: .55rem;
  color: #7a8898;
  letter-spacing: .5px;
}

html[data-theme=dark] .cc-trends-row2 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4px;
}

